@startuml
!include <c4/C4_Context>

System(marketplace, "Интернет-магазин одежды", "Веб-платформа для малых брендов и ИП на микросервисной архитектуре", "Go, React, PostgreSQL, MinIO, RabbitMQ, Redis")

Person(buyer, "Покупатель", "Ищет одежду, добавляет товары в корзину, оформляет заказы, оставляет отзывы и возвраты")
Person(seller, "Продавец", "Работает с карточками товаров, управляет остатками, обрабатывает заказы и отзывы")
Person(admin, "Администратор", "Модерирует жалобы, возвраты, управляет системными настройками")
Person(system_admin, "Системный администратор", "Работает с бэкапами, контролирует инфраструктуру сайта")

System_Ext(psp, "Платежный шлюз (PSP)", "ЮKassa")
System_Ext(delivery, "Службы доставки", "Почта России/СДЭК")
System_Ext(notification_ext, "Шлюзы уведомлений", "Telegram Bot API/SMTP-сервер для отправки алертов")

Rel(buyer, marketplace, "Использует веб-интерфейс", "HTTPS")
Rel(seller, marketplace, "Управляет ассортиментом и заказами", "HTTPS")
Rel(admin, marketplace, "Администрирует платформу", "HTTPS")
Rel(system_admin, marketplace, "Контролирует работоспособность сайта", "HTTPS")

Rel(marketplace, psp, "Проводит оплаты", "API / HTTPS")
Rel(marketplace, notification_ext, "Отправляет алерты при падении сайта", "SMTP / Telegram API")
Rel_Back(delivery, seller, "Работа с заказами", "Отправляют свои заказы или получают возвраты")
Rel_Back(delivery, buyer, "Работа с заказами", "Забирают заказанные вещи или делают возврат")
@enduml
